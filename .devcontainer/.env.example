# Copy this file to .devcontainer/.env before opening the container.

# Host path containing SEG C3 Narrow-Azimuth SEG-Y files.
SEISMIC_DATA_ROOT=/absolute/path/to/seg_c3_na

# Optional proxy settings.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Optional non-interactive authentication. Interactive sign-in also works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GH_TOKEN=
GITHUB_TOKEN=

# Use "latest" for a rolling developer environment or pin exact versions.
CODEX_VERSION=latest
CLAUDE_CODE_VERSION=latest
